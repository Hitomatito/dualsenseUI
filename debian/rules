#!/usr/bin/make -f

export DH_VERBOSE=1

%:
	dh $@ --with python3 --buildsystem=pybuild

# The Makefile in the project root is a developer helper (it runs
# "pip install --user -e ."), so debhelper must not use it.
override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	python3 -m pytest tests/ -v --tb=short

override_dh_install:
	dh_install
	# Install desktop file and icons
	install -Dm644 data/com.dualsenseui.app.desktop \
		$(CURDIR)/debian/dualsense-ui/usr/share/applications/com.dualsenseui.app.desktop
	install -Dm644 data/icons/com.dualsenseui.app.svg \
		$(CURDIR)/debian/dualsense-ui/usr/share/icons/hicolor/scalable/apps/com.dualsenseui.app.svg
	install -Dm644 data/icons/usb-symbolic.svg \
		$(CURDIR)/debian/dualsense-ui/usr/share/icons/hicolor/symbolic/devices/usb-symbolic.svg
